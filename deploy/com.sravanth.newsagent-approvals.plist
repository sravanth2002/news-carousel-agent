  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>/Users/sravanth/Library/Logs/newsagent-approvals.log</string>
  <key>StandardErrorPath</key><string>/Users/sravanth/Library/Logs/newsagent-approvals.log</string>
</dict>
</plist>